# Copie para .env e preencha. O .env está no .gitignore — nunca comite.
# Banco de Dados (Railway PostgreSQL nativo):
DATABASE_URL=postgresql://postgres:senha@postgres.railway.internal:5432/railway

# Segredo de assinatura dos tokens de admin:
JWT_SECRET=0e37faf187bc604b01f217c91d57dbc4a26dfae84a29d24f29f6dee3b832dfbe

# Host do banco de PRODUÇÃO para alertas em desenvolvimento local:
PROD_DB_HOST=

# Leitura com Google Gemini (comprovantes e notas fiscais):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Pagamento PIX Dinâmico com Baixa Automática (Mercado Pago):
# Obtenha em https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=

# Alertas e Notificações no Telegram:
# Crie com @BotFather e pegue o Chat ID com @userinfobot ou adicionando o bot no grupo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A Railway injeta PORT sozinha; localmente o padrão é 5000.
# PORT=5000
