# Copie para .env e preencha. O .env está no .gitignore — nunca comite.
# Em desenvolvimento, use um branch do Neon, não o banco de produção (veja DEV.md).

DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Segredo de assinatura dos tokens de admin. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Host do banco de PRODUÇÃO. Se preenchido, o app avisa em destaque quando você
# rodar em dev apontando para ele sem querer.
PROD_DB_HOST=

# Leitura automática de comprovantes e notas fiscais (opcional).
# Sem esta chave o upload continua funcionando, só entra como pendente de aprovação manual.
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-5.4

# A Railway injeta PORT sozinha; localmente o padrão é 5000.
# PORT=5000
